# ---------- Core ----------
NODE_ENV=development
# Public URL of the web app (used for invite links, OG tags, CORS). Production: https://noyta.in
APP_URL=http://localhost:3000
# Short invitation links (e.g. https://noyta.in/s/k7Qp2). Leave empty to use <APP_URL>/s/<code>.
# When you buy a short domain, point it at the web app and set both of these:
SHORT_LINK_BASE=
NEXT_PUBLIC_SHORT_HOST=
# Where the API listens / is reachable from the web server
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000

# ---------- Data ----------
# Neon Postgres: paste the connection string from the Neon console (Connection details). It must end in ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full
# Optional: Neon *direct* (non-pooled) string, used only for migrations. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=
# Upstash Redis: use the TLS "rediss://" URL from the Upstash console (ioredis / TCP, not the REST URL)
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# ---------- Storage (S3-compatible: Cloudflare R2 / AWS S3 / Backblaze B2 - no Docker/MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=cardai
S3_ACCESS_KEY_ID=cardai
S3_SECRET_ACCESS_KEY=cardai-secret
S3_FORCE_PATH_STYLE=true
# Public base URL objects are served from (CDN in prod)
STORAGE_PUBLIC_URL=http://localhost:9000/cardai

# ---------- Auth ----------
# 64+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
# Production: .noyta.in (shares the session across noyta.in and its subdomains)
COOKIE_DOMAIN=

# Email OTP: console | resend (https://resend.com). Production requires resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Noyta <no-reply@noyta.in>"
# Optional: where replies go (defaults to support@noyta.in)
EMAIL_REPLY_TO=
# Optional: separate sender for offers, so spam reports on promos never hurt sign-in code delivery.
# Verify the subdomain in Resend too (SPF + DKIM + DMARC), e.g. "Noyta Offers <offers@mail.noyta.in>"
EMAIL_FROM_MARKETING=
# Days between two offer emails to the same person (campaigns + automations)
MARKETING_MIN_GAP_DAYS=3
# Hourly abandoned-checkout + win-back emails (true/false) and an optional coupon for the reminder
LIFECYCLE_EMAILS=true
ABANDONED_CHECKOUT_COUPON=
# Optional: Resend → Webhooks → add <APP_URL>/api/mail/webhooks/resend (events: email.bounced, email.complained), paste its signing secret
RESEND_WEBHOOK_SECRET=

# "Continue with Google": OAuth 2.0 *Web application* client (Google Cloud Console > APIs & Services > Credentials).
#  - Authorised redirect URI:      <APP_URL>/api/auth/google/callback   (e.g. http://localhost:3100/api/auth/google/callback)
#  - Authorised JavaScript origin: <APP_URL>                            (only needed for the popup fallback)
# With both values set, the app uses the server-side redirect flow (code + PKCE). With only the ID, it falls back
# to Google's popup. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- AI (OpenRouter) ----------
OPENROUTER_API_KEY=
# Comma-separated: first is primary, rest are automatic fallbacks
AI_TEXT_MODELS=google/gemini-4-hydrogen,anthropic/claude-haiku-5.5,deepseek/deepseek-v4.1-flash-1017
# Image-reading models for 'upload your printed card' (comma-separated, first is primary)
AI_VISION_MODELS=google/gemini-4-hydrogen,anthropic/claude-haiku-5.5
AI_IMAGE_MODEL=google/gemini-3.1-flash-image
AI_IMAGE_PREMIUM_MODEL=google/gemini-3-pro-image
AI_VIDEO_MODEL=google/veo-3.1-lite
AI_AUDIO_MODELS=google/gemini-omni-1.2-flash,google/gemini-4-hydrogen

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# Approved template name for sending invites to guests
WHATSAPP_INVITE_TEMPLATE=invitation_link

# ---------- Admin ----------
# Comma-separated emails that become admins when they sign in (normal email code / Google).
# Admins can promote others from /admin/users.
ADMIN_EMAILS=you@example.com
# Admins confirm a 6-digit email code once per device every 12 h (default: on in production only).
ADMIN_MFA=
# Health checks every 10 min, 8 am IST admin summary, nightly metrics + analytics partition upkeep.
OPS_JOBS=true
# Alert when AI spend in 24 h passes this many USD.
ALERT_AI_USD_DAY=20
# Optional: WhatsApp number (with country code, digits only) that also gets critical alerts.
ADMIN_ALERT_WHATSAPP=
# Raw analytics events are kept this many months (daily rollups are kept forever).
ANALYTICS_RETENTION_MONTHS=13
# Optional Neon read-replica URL for admin reports (unset = primary).
DATABASE_URL_READ=

# ---------- Seed ----------
SEED_ADMIN_PHONE=+919999999999

# ---------- Web (Next.js) ----------
# Production: https://noyta.in
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Worker tuning (optional). Production defaults live in infra/deploy/docker-compose.prod.yml
# (sized for a 1 vCPU / 2 GB droplet); set them here only to override.
# RENDER_CONCURRENCY=2
# REMOTION_CONCURRENCY=
# OFFTHREAD_VIDEO_CACHE_MB=256
# BROWSER_RECYCLE_AFTER=40
# Close Chrome after this many idle seconds to free its RAM (0 = keep it open)
# BROWSER_IDLE_CLOSE_SEC=300
# Container limits (production compose only)
# WORKER_MEMORY=1200m
# API_MEMORY=512m
