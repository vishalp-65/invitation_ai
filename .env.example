# ---------- Core ----------
NODE_ENV=development
# Public URL of the web app (used for invite links, OG tags, CORS)
APP_URL=http://localhost:3000
# Short invitation links (inv.to/k7Qp2). Leave empty to use <APP_URL>/s/<code>.
# When you buy a short domain, point it at the web app and set both of these:
SHORT_LINK_BASE=
NEXT_PUBLIC_SHORT_HOST=
# Where the API listens / is reachable from the web server
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000

# ---------- Data ----------
DATABASE_URL=postgres://cardai:cardai@localhost:5432/cardai
REDIS_URL=redis://localhost:6379

# ---------- Storage (S3-compatible: MinIO locally, Cloudflare R2 / S3 in prod) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=cardai
S3_ACCESS_KEY_ID=cardai
S3_SECRET_ACCESS_KEY=cardai-secret
S3_FORCE_PATH_STYLE=true
# Public base URL objects are served from (CDN in prod)
STORAGE_PUBLIC_URL=http://localhost:9000/cardai

# ---------- Auth ----------
# 64+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
COOKIE_DOMAIN=

# Email OTP: console | resend (https://resend.com). Production requires resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="CardAI <no-reply@yourdomain.com>"

# "Continue with Google": OAuth 2.0 *Web application* client (Google Cloud Console > APIs & Services > Credentials).
#  - Authorised redirect URI:      <APP_URL>/api/auth/google/callback   (e.g. http://localhost:3100/api/auth/google/callback)
#  - Authorised JavaScript origin: <APP_URL>                            (only needed for the popup fallback)
# With both values set, the app uses the server-side redirect flow (code + PKCE). With only the ID, it falls back
# to Google's popup. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- AI (OpenRouter) ----------
OPENROUTER_API_KEY=
# Comma-separated: first is primary, rest are automatic fallbacks
AI_TEXT_MODELS=google/gemini-4-hydrogen,anthropic/claude-haiku-5.5,deepseek/deepseek-v4.1-flash-1017
AI_IMAGE_MODEL=google/gemini-3.1-flash-image
AI_IMAGE_PREMIUM_MODEL=google/gemini-3-pro-image
AI_VIDEO_MODEL=google/veo-3.1-lite
AI_AUDIO_MODELS=google/gemini-omni-1.2-flash,google/gemini-4-hydrogen

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# Approved template name for sending invites to guests
WHATSAPP_INVITE_TEMPLATE=invitation_link

# ---------- Admin ----------
# Comma-separated emails that become admins when they sign in (normal email code / Google).
# Admins can promote others from /admin/users.
ADMIN_EMAILS=you@example.com

# ---------- Seed ----------
SEED_ADMIN_PHONE=+919999999999

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Worker memory tuning (optional)
# RENDER_CONCURRENCY=2
# REMOTION_CONCURRENCY=
# OFFTHREAD_VIDEO_CACHE_MB=256
# BROWSER_RECYCLE_AFTER=40
