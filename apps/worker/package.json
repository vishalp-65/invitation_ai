{
  "name": "@cardai/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background workers: Remotion card/video rendering, PDF assembly, AI video clips.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "showcase": "node --env-file-if-exists=../../.env dist/scripts/render-showcase.js"
  },
  "dependencies": {
    "@cardai/ai": "0.1.0",
    "@cardai/db": "0.1.0",
    "@cardai/infra": "0.1.0",
    "@cardai/shared": "0.1.0",
    "@cardai/templates": "0.1.0",
    "@remotion/bundler": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "bullmq": "^6.7.6",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.543",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.2.0",
    "tsc-watch": "^7.2.1"
  }
}
