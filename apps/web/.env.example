# Frontend (apps/web) environment. Copy to .env.local for local development:
#   cp .env.example .env.local
# On Vercel, set the same names in Project Settings -> Environment Variables
# (production values are listed in docs/DEPLOYMENT.md, Step 5).
# NEXT_PUBLIC_* values are baked in at build time: restart `next dev` / redeploy after changing them.

# Where the Next.js server forwards /api/* calls (the NestJS API). Production: https://api.noyta.in
API_INTERNAL_URL=http://127.0.0.1:4000

# Canonical site URL (metadata, sitemap, robots, share links). Production: https://noyta.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL for uploaded media (added to CSP and the image allow-list).
# Local: MinIO. Production: https://noyta-media.blr1.cdn.digitaloceanspaces.com
STORAGE_PUBLIC_URL=http://localhost:9000/cardai

# Razorpay publishable key id (never the secret). Leave empty locally to keep checkout off.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Short invitation-link domain, e.g. a short domain serving /s/<code>. Empty = <APP_URL>/s/<code>.
NEXT_PUBLIC_SHORT_HOST=

# Shared with the API's CLIENT_IP_SECRET so it can trust the visitor's real IP for rate limits.
# Optional locally (leave empty on both sides); required in production, identical on Vercel and the API.
CLIENT_IP_SECRET=
