{
  "name": "@cardai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run migrate -w @cardai/db",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "prestart": "npm run migrate -w @cardai/db",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cardai/ai": "0.1.0",
    "@cardai/db": "0.1.0",
    "@cardai/infra": "0.1.0",
    "@cardai/shared": "0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-fastify": "^12.5.0",
    "bullmq": "^6.7.6",
    "jose": "^6.2.17",
    "nanoid": "^6.0.2",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.2.0",
    "tsc-watch": "^7.1.1",
    "vitest": "^5.1.0"
  }
}
